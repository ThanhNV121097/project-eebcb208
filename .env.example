# Local PostgreSQL username for docker compose.
POSTGRES_USER=app

# Local PostgreSQL password for docker compose; replace outside git.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name for docker compose.
POSTGRES_DB=app

# Published backend port on host.
BACKEND_PORT=8080

# Published frontend port on host.
FRONTEND_PORT=3000

# Browser-visible backend origin for frontend build/runtime.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend origin for frontend server-side rendering in compose.
API_ORIGIN=http://backend:8080
